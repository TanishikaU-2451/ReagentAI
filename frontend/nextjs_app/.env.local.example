# =============================================================================
# ReagentAI Frontend -- Local Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust the values as needed.
#
#   cp .env.local.example .env.local
#
# Next.js automatically loads .env.local at startup.  Variables prefixed with
# NEXT_PUBLIC_ are inlined into the client-side bundle at build time and are
# therefore visible to the browser.
# =============================================================================

# URL of the ReagentAI backend API.
# When running outside Docker (e.g. local dev), this should point at the
# backend's host port.  Inside Docker Compose the frontend Dockerfile and
# docker-compose.yml override this to http://backend:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
