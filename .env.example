# ReagentAI Environment Configuration
# =====================================

# HuggingFace API
HUGGINGFACE_API_TOKEN=hf_your_token_here

# GitHub API
GITHUB_TOKEN=ghp_your_token_here

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000


# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Docker Sandbox
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=2g

# Vector Store
VECTOR_STORE_PATH=./vector_store
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Agent Models (HuggingFace model IDs) - WORKING ALTERNATIVES
# These models are guaranteed to work with the Inference API
RESEARCH_AGENT_MODEL=microsoft/DialoGPT-medium
PLANNING_AGENT_MODEL=google/flan-t5-large
ARCHITECTURE_AGENT_MODEL=google/flan-t5-large
CODING_AGENT_MODEL=microsoft/DialoGPT-medium
DEBUG_AGENT_MODEL=microsoft/DialoGPT-medium
CHAT_AGENT_MODEL=microsoft/DialoGPT-medium
TESTING_AGENT_MODEL=microsoft/DialoGPT-medium
VALIDATION_AGENT_MODEL=microsoft/DialoGPT-medium
DIAGRAM_AGENT_MODEL=google/flan-t5-large

# Original models (may require license acceptance or different endpoints)
# RESEARCH_AGENT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# PLANNING_AGENT_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
# CODING_AGENT_MODEL=meta-llama/CodeLlama-34b-Instruct-hf

# Logging
LOG_LEVEL=DEBUG
LOG_PATH=./logs

# Max debug retry attempts
MAX_DEBUG_ATTEMPTS=5

# Generated projects directory
GENERATED_PROJECTS_PATH=./generated_projects
